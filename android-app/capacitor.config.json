{
  "appId": "ir.moradisadegh.marketboard",
  "appName": "مالی من",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1A2848"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#1A2848",
      "launchAutoHide": true,
      "launchShowDuration": 600
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_mali",
      "iconColor": "#D9A02A"
    }
  }
}
