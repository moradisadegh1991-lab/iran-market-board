    "wire-plugin": "node scripts/wire-native-plugin.mjs",
    "test:wireplugin": "node scripts/wire-plugin-test.mjs",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#1a2848' --splashBackgroundColor '#1a2848' && node scripts/copy-res-extra.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/assets": "^3.0.5"
  }
}
