{
  "name": "iran-market-board-android",
  "version": "1.0.0",
  "private": true,
  "description": "اپ اندروید «مالی من» — کل اپ (خروجی ایستای Next) داخل APK؛ www/ فقط موتورهای مشترک (پارسر پیامک، بازی)",
  "scripts": {
    "build:web": "node ../scripts/build-app-web.mjs",
    "sync": "cap sync android",
    "open": "cap open android",
