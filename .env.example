# ── Storage (Upstash Redis — از Vercel Marketplace اضافه کن؛ یکی از دو جفت کافی است)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Data sources
BRSAPI_KEY=
BRSAPI_BASE=https://Api.BrsApi.ir
# BRSAPI_SYMBOLS_QUERY=type=1
COINGECKO_API_KEY=
# منابعی که از IP ویرسل مسدودند و فقط از /api/ingest پر می‌شوند (کاما جدا): tgju,nobitex,brsIndex,brsSymbols
INGEST_ONLY_SOURCES=

# ── Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_BOT_USERNAME=
DAILY_BROADCAST=1

# ── Security
ADMIN_SECRET=
CRON_SECRET=

# ── Model assumptions
DEFAULT_RISK_PROFILE=balanced
FIXED_INCOME_YIELD=0.30
TSE_MIN_TVAL=5000000000
# BrsApi رایگان: TSETMC_AllSymbols و TSETMC_Index هر کدام سقف ۱۰۰ ریکوئست روزانه دارند؛
# پیش‌فرض‌های پایین برای ماندن زیر همین سقف تنظیم شده‌اند. با پلن پولی می‌توانید کمتر کنید.
TSE_SESSION_TTL_SEC=240
TSE_OFFHOURS_TTL_SEC=3600
SNAPSHOT_TTL_SEC=60
PUBLIC_BASE_URL=

# Claude — مشاور مالی (/advisor) و مرور روایی معامله‌گر شبیه‌ساز
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# رمزی که کاربر برای استفاده از مشاور وارد می‌کند؛ اگر خالی باشد ADMIN_SECRET استفاده می‌شود
ADVISOR_SECRET=
# مدل مشاور (پیش‌فرض claude-opus-5-5) و سقف پرسش در روز
# ADVISOR_MODEL=claude-opus-5-5
# ADVISOR_DAILY_LIMIT=200
